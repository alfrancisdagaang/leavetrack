# LeaveTrack environment variables.
# Copy to .env.local for local development. Never commit real values.
# Day 0 runs with NO .env file at all: every variable below is optional in
# development and validated strictly only when APP_ENV=production.

# --- Runtime environment ---------------------------------------------------
# development | staging | production
# Controls config strictness and the session cookie's Secure flag.
APP_ENV=development

# pino log level: fatal | error | warn | info | debug | trace
# Defaults to "debug" in development, "info" otherwise.
LOG_LEVEL=

# --- Database (Supabase Postgres) -----------------------------------------
# App connection — MUST be the Supabase *pooler* URL (Supavisor, transaction
# mode, port 6543). Never point the app at the direct connection.
# Required when APP_ENV=production. Unset in Day 0 → /api/health reports db: "not_configured".
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Direct connection (port 5432) — used ONLY by `supabase db push` for migrations,
# never by the running app.
# Example: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DIRECT_URL=

# --- Scheduled jobs --------------------------------------------------------
# Shared secret for /api/jobs/*. Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
# automatically when this is set in the Vercel project. Requests without it get 401.
# Required when APP_ENV=production. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Display ---------------------------------------------------------------
# IANA time zone that decides which day "today" is on the dashboard calendar,
# e.g. Asia/Manila. Optional; unset means UTC (the same clock the accrual job uses).
APP_TIMEZONE=

# --- Sign-in (Supabase Auth, ADR-LeaveTrack-E003) --------------------------
# Project URL and anon key from Supabase -> Project Settings -> API. Both are public
# by design (they reach the browser); never put the service-role key here.
# Required when APP_ENV=production. Without them nobody can sign in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# true = honour the labelled mock-role fallback login. Unset: on in development, off
# elsewhere. Switch it off (or leave it unset) on any public URL once real sign-in is live.
ALLOW_MOCK_LOGIN=
